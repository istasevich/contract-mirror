<div class="modal fade" id="rewriteClauseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Rewrite clause</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body d-flex flex-column gap-3">
                <div>
                    <div class="cm-label">Original clause</div>
                    <div id="rewriteOriginalClause" class="cm-quote-box"></div>
                </div>

                <div id="rewriteLoading" class="d-none">
                    <div class="cm-empty-card">Generating safer version...</div>
                </div>

                <div id="rewriteError" class="d-none">
                    <div class="alert alert-danger mb-0">
                        Failed to rewrite clause. Please try again.
                    </div>
                </div>

                <div id="rewriteResult" class="d-none">
                    <div class="cm-label">Suggested safer wording</div>
                    <div id="rewriteOutput" class="cm-suggestion-box"></div>

                    <div class="cm-label mt-3">Reasoning</div>
                    <div id="rewriteReasoning" class="cm-body-text"></div>
                </div>
            </div>
        </div>
    </div>
</div>
