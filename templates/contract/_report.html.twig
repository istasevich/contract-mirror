{% set isDemo = isDemo ?? false %}


{% if isDemo %}
    <div class="mb-4 p-3 bg-yellow-500/10 border border-yellow-500/30 rounded-xl text-yellow-300 text-sm">
        ⚡ Demo report — upload your contract to analyze your own
    </div>
{% endif %}

<div class="flex flex-col gap-6">

    {% include 'contract/_report_header.html.twig' with {
        report: report,
        publicId: publicId
    } %}
    {% include 'contract/_report_summary.html.twig' %}

    <div class="flex flex-col gap-4">
        {% for issue in report.issues|slice(0, 2) %}
            {% include 'contract/_report_issue_card.html.twig' %}
        {% endfor %}
    </div>

    {% if isLocked %}
        <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl px-4 py-3 text-amber-200 text-sm">
            This contract contains {{ report.issues|length }} risks — only 2 are shown in the free version.
        </div>

        {% include 'contract/_paywall.html.twig' with { publicId: publicId } %}

        <div class="flex flex-col gap-4 blur-sm pointer-events-none opacity-50 select-none">
            {% for issue in report.issues|slice(2) %}
                {% include 'contract/_report_issue_card.html.twig' %}
            {% endfor %}

            {% for item in report.missingProtections %}
                {% include 'contract/_report_missing_protection_card.html.twig' with {
                    protection: item
                } %}
            {% endfor %}
        </div>

        <div class="mt-8 text-center">
            <a href="https://gumroad.com/l/xekca?wanted=true&custom={{ publicId }}"
               class="inline-block bg-violet-500 hover:bg-violet-600 text-white px-8 py-4 rounded-xl font-bold text-lg transition-colors">
                Get full analysis for $5
            </a>
        </div>
    {% else %}
        <div class="flex flex-col gap-4 mt-6">
            {% for issue in report.issues|slice(2) %}
                {% include 'contract/_report_issue_card.html.twig' %}
            {% endfor %}

            {% for item in report.missingProtections %}
                {% include 'contract/_report_missing_protection_card.html.twig' with {
                    protection: item
                } %}
            {% endfor %}
        </div>
    {% endif %}

</div>
