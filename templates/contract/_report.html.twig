
<div class="space-y-8">
    {% include 'contract/_report_header.html.twig' with { report: report } %}

    <div class="js-report-simple space-y-8">
        {% include 'contract/_report_summary.html.twig' with { report: report } %}

        <section>
            <div class="mb-4 flex items-center justify-between gap-4">
                <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Top risks</h3>
                {% if report.issues is not empty %}
                    <span class="text-sm text-slate-500">{{ report.issues|length }} issue(s)</span>
                {% endif %}
            </div>

            {% if report.issues is empty %}
                <div class="rounded-3xl border border-white/10 bg-white/5 p-5 text-slate-300">
                    No material risks were detected in the current document.
                </div>
            {% else %}
                <div class="grid gap-4 lg:grid-cols-2">
                    {% for issue in report.issues|slice(0, 4) %}
                        <article class="rounded-[28px] border border-white/10 bg-white/5 p-5">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <div class="mb-2 flex flex-wrap gap-2">
                                        <span class="rounded-full border px-3 py-1 text-xs font-bold uppercase tracking-[0.18em]
                                            {% if issue.severity == 'HIGH' %}border-red-400/20 bg-red-500/10 text-red-200
                                            {% elseif issue.severity == 'LOW' %}border-emerald-400/20 bg-emerald-500/10 text-emerald-200
                                            {% else %}border-amber-400/20 bg-amber-500/10 text-amber-200{% endif %}">
                                            {{ issue.severity }}
                                        </span>
                                        <span class="rounded-full border border-white/10 bg-slate-950/40 px-3 py-1 text-xs text-slate-300">{{ issue.category }}</span>
                                    </div>
                                    <h4 class="text-lg font-bold text-white">{{ issue.title }}</h4>
                                </div>
                            </div>

                            <p class="mt-4 text-sm text-slate-200">{{ issue.plainExplanation }}</p>
                            <div class="mt-4 rounded-2xl border border-cyan-400/20 bg-cyan-400/10 p-4">
                                <div class="text-xs font-bold uppercase tracking-[0.18em] text-cyan-200">Why it matters</div>
                                <p class="mt-2 text-sm text-slate-100">{{ issue.whyItMatters }}</p>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        <section>
            <div class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Missing protections</div>

            {% if report.missingProtections is empty %}
                <div class="rounded-3xl border border-white/10 bg-white/5 p-5 text-slate-300">
                    No major missing protections were detected.
                </div>
            {% else %}
                <div class="grid gap-4 lg:grid-cols-2">
                    {% for protection in report.missingProtections|slice(0, 2) %}
                        {% include 'contract/_report_missing_protection_card.html.twig' with { protection: protection } %}
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>

    <div class="js-report-detailed hidden space-y-6">
        <section>
            <div class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Clause analysis</div>

            {% if report.issues is empty %}
                <div class="rounded-3xl border border-white/10 bg-white/5 p-5 text-slate-300">
                    No clause-level issues found.
                </div>
            {% else %}
                <div class="space-y-5">
                    {% for issue in report.issues %}
                        {% include 'contract/_report_issue_card.html.twig' with { issue: issue } %}
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        <section>
            <div class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Missing protections</div>

            {% if report.missingProtections is empty %}
                <div class="rounded-3xl border border-white/10 bg-white/5 p-5 text-slate-300">
                    No major missing protections were detected.
                </div>
            {% else %}
                <div class="space-y-5">
                    {% for protection in report.missingProtections %}
                        {% include 'contract/_report_missing_protection_card.html.twig' with { protection: protection } %}
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        <section class="rounded-[28px] border border-white/10 bg-white/5 p-6">
            <div class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Final recommendation</div>
            <div class="mt-4 text-xl font-bold text-white">{{ report.finalRecommendation }}</div>
            <p class="mt-3 text-slate-300">{{ report.signingRecommendation }}</p>
        </section>
    </div>
</div>
