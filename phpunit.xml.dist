<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" failOnDeprecation="true" failOnWarning="true">
    <php>
        <env name="APP_ENV" value="test"/>
        <env name="APP_SECRET" value="test-secret"/>
        <env name="OPENAI_API_KEY" value="test-openai-key"/>
        <env name="OPENAI_MODEL" value="gpt-4.1-mini"/>
        <env name="CONTRACT_MIRROR_FAKE_REPORT" value="false"/>
        <env name="DATABASE_URL" value="sqlite:///%kernel.project_dir%/var/test.db"/>
        <env name="REDIS_URL" value="redis://localhost:6379"/>
        <env name="CRYPTO_WALLET_ADDRESS" value="TTestWalletAddress"/>
        <env name="USDT_TRON_CONTRACT_ADDRESS" value="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"/>
        <env name="TRON_MIN_CONFIRMATIONS" value="1"/>
        <env name="GUMROAD_SELLER_ID" value="seller-test"/>
        <env name="GUMROAD_ACCESS_TOKEN" value="token-test"/>
    </php>
    <testsuites>
        <testsuite name="ContractMirror">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
