{
    "name": "contractmirror/app",
    "type": "project",
    "description": "ContractMirror MVP skeleton on Symfony",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-zip": "*",
        "symfony/console": "7.3.*",
        "symfony/dependency-injection": "7.3.*",
        "symfony/dotenv": "7.3.*",
        "symfony/flex": "*",
        "symfony/framework-bundle": "7.3.*",
        "symfony/http-client": "7.3.*",
        "symfony/http-foundation": "7.3.*",
        "symfony/routing": "7.3.*",
        "symfony/runtime": "7.3.*",
        "symfony/serializer": "7.3.*",
        "symfony/validator": "7.3.*",
        "symfony/yaml": "7.3.*",
        "symfony/twig-bundle": "7.3.*",
        "twig/twig": "^3.0",
        "twig/extra-bundle": "^3.0",
        "phpoffice/phpword": "^1.3"
    },
    "require-dev": {
        "symfony/debug-bundle": "7.3.*",
        "symfony/error-handler": "7.3.*",
        "symfony/maker-bundle": "^1.64",
        "symfony/stopwatch": "7.3.*",
        "symfony/var-dumper": "7.3.*",
        "symfony/web-profiler-bundle": "7.3.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
